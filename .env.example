# Create a restricted SendGrid API key with Mail Send access only.
SENDGRID_API_KEY=SG.replace-with-your-api-key

# The From address must belong to a SendGrid-authenticated domain.
WAITLIST_FROM_EMAIL="Project Q <waitlist@example.com>"

# Comma-separate multiple internal notification recipients if needed.
WAITLIST_TO_EMAIL=team@example.com

# Keep false in Vercel Preview; set true in Production when ready.
WAITLIST_SEND_CONFIRMATION=false

# Required when WAITLIST_SEND_CONFIRMATION=true. Dynamic IDs start with "d-".
SENDGRID_CONFIRMATION_TEMPLATE_ID=d-replace-with-your-template-id
